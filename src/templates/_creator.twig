<div id="craft-image-creator-standalone" class="craft-image-creator-standalone">
    <p class="craft-image-creator-standalone__intro">
        {{ 'Generate a standalone image Asset by entering context directly, without attaching it to an entry.'|t('craft-image-creator') }}
    </p>

    {% if standaloneAvailable %}
        <div class="buttons">
            <button
                id="craft-image-creator-open"
                class="btn submit"
                type="button"
            >{{ 'Create image'|t('craft-image-creator') }}</button>
        </div>

        <div class="craft-image-creator-standalone__saved" hidden>
            <strong>{{ 'Saved Asset'|t('craft-image-creator') }}</strong>
            <a class="go" href=""></a>
        </div>
    {% else %}
        <p class="warning with-icon">
            {{ standaloneUnavailableMessage }}
        </p>
    {% endif %}
</div>
