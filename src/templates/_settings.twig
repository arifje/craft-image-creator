{% import '_includes/forms' as forms %}

<h2>{{ 'Standalone Image Creator'|t('craft-image-creator') }}</h2>

{{ forms.selectField({
    label: 'Storage location'|t('craft-image-creator'),
    instructions: 'Choose the filesystem for standalone images. Only filesystems connected to an Asset volume are shown, and images are saved at that volume’s root.'|t('craft-image-creator'),
    id: 'standaloneVolumeUid',
    name: 'standaloneVolumeUid',
    options: standaloneStorageOptions,
    value: settings.getStandaloneVolumeUid(),
    errors: settings.getErrors('standaloneVolumeUid'),
}) }}

<hr>
<h2>{{ 'Field integration'|t('craft-image-creator') }}</h2>

{{ forms.checkboxSelectField({
    label: 'Assets fields'|t('craft-image-creator'),
    instructions: 'Show “Create with AI” below these image-capable Assets fields. Empty fields, nested fields, Matrix blocks, and dynamically loaded tabs are supported.'|t('craft-image-creator'),
    id: 'assetFieldUids',
    name: 'assetFieldUids',
    options: assetFieldOptions,
    values: settings.getAssetFieldUids(),
    showAllOption: false,
}) }}

{{ forms.checkboxSelectField({
    label: 'Context fields'|t('craft-image-creator'),
    instructions: 'These values appear in the modal and are appended to the image prompt. Editors can adjust them for a generation without changing the entry.'|t('craft-image-creator'),
    id: 'contextFields',
    name: 'contextFields',
    options: contextFieldOptions,
    values: settings.getContextFields(),
    showAllOption: false,
}) }}

{{ forms.textareaField({
    label: 'Image prompt'|t('craft-image-creator'),
    instructions: 'The base instruction for every generated image. Enter text or an environment variable such as $IMAGE_CREATOR_PROMPT.'|t('craft-image-creator'),
    id: 'prompt',
    name: 'prompt',
    value: settings.prompt,
    rows: 6,
    maxlength: 20000,
    placeholder: '$IMAGE_CREATOR_PROMPT',
}) }}

{{ forms.selectField({
    label: 'Default provider'|t('craft-image-creator'),
    instructions: 'The provider selected first in the creation modal.'|t('craft-image-creator'),
    id: 'defaultProvider',
    name: 'defaultProvider',
    options: providerOptions,
    value: settings.defaultProvider,
}) }}

<hr>
<h2>OpenAI</h2>

{{ forms.autosuggestField({
    label: 'API key'|t('craft-image-creator'),
    id: 'openAiApiKey',
    name: 'openAiApiKey',
    value: settings.openAiApiKey,
    suggestEnvVars: true,
    suggestAliases: true,
    placeholder: '$OPENAI_API_KEY',
}) }}

{{ forms.selectField({
    label: 'Image model'|t('craft-image-creator'),
    instructions: 'Choose an image model supported by this plugin.'|t('craft-image-creator'),
    id: 'openAiModel',
    name: 'openAiModel',
    value: settings.openAiModel,
    options: modelOptions.openai,
}) }}

