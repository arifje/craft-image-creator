{% import '_includes/forms' as forms %}

<div class="craft-image-creator-settings">

    <section id="image-creator-settings-panel-general" class="">
        <h2>{{ 'Standalone Image Creator'|t('craft-image-creator') }}</h2>

{{ forms.selectField({
    label: 'Storage location'|t('craft-image-creator'),
    instructions: 'Choose the filesystem for standalone images. Only filesystems connected to an Asset volume are shown, and images are saved at that volume’s root.'|t('craft-image-creator'),
    id: 'standaloneVolumeUid',
    name: 'standaloneVolumeUid',
    options: standaloneStorageOptions,
    value: settings.getStandaloneVolumeUid(),
    errors: settings.getErrors('standaloneVolumeUid'),
}) }}

<hr>
<h2>{{ 'Field integration'|t('craft-image-creator') }}</h2>

{{ forms.checkboxSelectField({
    label: 'Assets fields'|t('craft-image-creator'),
    instructions: 'Show “Create with AI” below these image-capable Assets fields. Empty fields, nested fields, Matrix blocks, and dynamically loaded tabs are supported.'|t('craft-image-creator'),
    id: 'assetFieldUids',
    name: 'assetFieldUids',
    options: assetFieldOptions,
    values: settings.getAssetFieldUids(),
    showAllOption: false,
    errors: settings.getErrors('assetFieldUids'),
}) }}

{{ forms.checkboxSelectField({
    label: 'Context fields'|t('craft-image-creator'),
    instructions: 'These values appear in the modal and are appended to the image prompt. Editors can adjust them for a generation without changing the entry.'|t('craft-image-creator'),
    id: 'contextFields',
    name: 'contextFields',
    options: contextFieldOptions,
    values: settings.getContextFields(),
    showAllOption: false,
    errors: settings.getErrors('contextFields'),
}) }}

{{ forms.selectField({
    label: 'Default provider'|t('craft-image-creator'),
    instructions: 'The provider selected first in the creation modal.'|t('craft-image-creator'),
    id: 'defaultProvider',
    name: 'defaultProvider',
    options: providerOptions,
    value: settings.defaultProvider,
    errors: settings.getErrors('defaultProvider'),
}) }}

    </section>

    <section id="image-creator-settings-panel-openai" class="hidden">
        <h2>OpenAI</h2>

{{ forms.autosuggestField({
    label: 'API key'|t('craft-image-creator'),
    id: 'openAiApiKey',
    name: 'openAiApiKey',
    value: settings.openAiApiKey,
    suggestEnvVars: true,
    suggestAliases: true,
    placeholder: '$OPENAI_API_KEY',
    errors: settings.getErrors('openAiApiKey'),
}) }}

{{ forms.selectField({
    label: 'Image model'|t('craft-image-creator'),
    instructions: 'Choose an image model available to your API key. Save API key changes before refreshing the list.'|t('craft-image-creator'),
    id: 'openAiModel',
    name: 'openAiModel',
    value: settings.openAiModel,
    options: modelOptions.openai,
    errors: settings.getErrors('openAiModel'),
}) }}
<div class="craft-image-creator-model-refresh" data-model-provider="openai" data-model-field="openAiModel" data-api-key-field="openAiApiKey">
    <button type="button" class="btn craft-image-creator-model-refresh__button">{{ 'Refresh models'|t('craft-image-creator') }}</button>
    <span class="light craft-image-creator-model-refresh__status" role="status" aria-live="polite"></span>
</div>

    </section>

    <section id="image-creator-settings-panel-xai" class="hidden">
        <h2>Grok (xAI)</h2>

{{ forms.autosuggestField({
    label: 'API key'|t('craft-image-creator'),
    id: 'xAiApiKey',
    name: 'xAiApiKey',
    value: settings.xAiApiKey,
    suggestEnvVars: true,
    suggestAliases: true,
    placeholder: '$XAI_API_KEY',
    errors: settings.getErrors('xAiApiKey'),
}) }}

{{ forms.selectField({
    label: 'Image model'|t('craft-image-creator'),
    instructions: 'Choose an image model available to your API key. Save API key changes before refreshing the list.'|t('craft-image-creator'),
    id: 'xAiModel',
    name: 'xAiModel',
    value: settings.xAiModel,
    options: modelOptions.xai,
    errors: settings.getErrors('xAiModel'),
}) }}
<div class="craft-image-creator-model-refresh" data-model-provider="xai" data-model-field="xAiModel" data-api-key-field="xAiApiKey">
    <button type="button" class="btn craft-image-creator-model-refresh__button">{{ 'Refresh models'|t('craft-image-creator') }}</button>
    <span class="light craft-image-creator-model-refresh__status" role="status" aria-live="polite"></span>
</div>

    </section>

    <section id="image-creator-settings-panel-google" class="hidden">
        <h2>Google Gemini</h2>

{{ forms.autosuggestField({
    label: 'API key'|t('craft-image-creator'),
    id: 'googleApiKey',
    name: 'googleApiKey',
    value: settings.googleApiKey,
    suggestEnvVars: true,
    suggestAliases: true,
    placeholder: '$GEMINI_API_KEY',
    errors: settings.getErrors('googleApiKey'),
}) }}

{{ forms.selectField({
    label: 'Image model'|t('craft-image-creator'),
    instructions: 'Choose an image model available to your API key. Save API key changes before refreshing the list.'|t('craft-image-creator'),
    id: 'googleModel',
    name: 'googleModel',
    value: settings.googleModel,
    options: modelOptions.google,
    errors: settings.getErrors('googleModel'),
}) }}
<div class="craft-image-creator-model-refresh" data-model-provider="google" data-model-field="googleModel" data-api-key-field="googleApiKey">
    <button type="button" class="btn craft-image-creator-model-refresh__button">{{ 'Refresh models'|t('craft-image-creator') }}</button>
    <span class="light craft-image-creator-model-refresh__status" role="status" aria-live="polite"></span>
</div>

    </section>
</div>
