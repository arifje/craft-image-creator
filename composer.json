{
    "name": "arifje/craft-image-creator",
    "description": "Create AI-generated Craft CMS Assets from the control panel or Assets fields.",
    "type": "craft-plugin",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "craft",
        "craftcms",
        "ai",
        "assets",
        "image generation"
    ],
    "support": {
        "issues": "https://github.com/arifje/craft-image-creator/issues",
        "source": "https://github.com/arifje/craft-image-creator"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.11.0",
        "guzzlehttp/guzzle": "^7.4"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "arifje\\craftimagecreator\\": "src/"
        }
    },
    "extra": {
        "handle": "craft-image-creator",
        "name": "Image Creator",
        "developer": "Arjan Brinkman",
        "developerUrl": "https://github.com/arifje",
        "documentationUrl": "https://github.com/arifje/craft-image-creator",
        "class": "arifje\\craftimagecreator\\Plugin"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan analyse --no-progress --debug --memory-limit=1G",
        "test": [
            "@php tests/static-contract.php",
            "@php tests/provider-errors.php",
            "@php tests/model-catalog.php",
            "@php tests/asset-save.php"
        ],
        "check": [
            "@phpstan",
            "@check-cs",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    }
}
